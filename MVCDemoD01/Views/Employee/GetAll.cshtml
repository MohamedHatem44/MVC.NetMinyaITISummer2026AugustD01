<h1 style="color:green; text-align:center">
    All Employees
</h1>

<table class="table">
    <thead>
        <tr>
            <th scope="col">Id</th>
            <th scope="col">Name</th>
            <th scope="col">Age</th>
            <th scope="col">Salary</th>
            <th scope="col">Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var emp in Model)
        {
            <tr>
                <th>@emp.Id</th>
                <td>@emp.Name</td>
                <td>@emp.Age</td>
                <td>@emp.Salary</td>
                <td>
                    <a href="~/Employee/GetById/@emp.Id" class="btn btn-primary">
                        View Details
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>